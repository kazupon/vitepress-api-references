{
  "name": "vitepress-api-references",
  "version": "0.3.0",
  "description": "Enable JSDoc API Reference for VitePress",
  "keywords": [
    "api-references",
    "docs",
    "documentation",
    "markdown",
    "vitepress"
  ],
  "homepage": "https://github.com/kazupon/vitepress-api-references#readme",
  "bugs": {
    "url": "https://github.com/kazupon/vitepress-api-references/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vitepress-api-references.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "knip": "knip",
    "dev": "vp pack --watch",
    "docs:build": "vp exec vitepress build docs",
    "docs:preview": "vp exec vitepress preview docs",
    "docs:dev": "vp exec vitepress dev docs",
    "docs:standalone": "node standalone/generate.ts",
    "test": "vp test",
    "test:fixtures": "vp exec vitepress build tests/fixtures/basic/docs",
    "check": "vp check && knip",
    "prepublishOnly": "vp run build",
    "release": "node scripts/release-preflight.ts && bumpp",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@ox-content/napi": "3.0.0-alpha.4"
  },
  "devDependencies": {
    "@kazupon/vp-config": "^0.5.1",
    "@types/node": "^25.9.5",
    "bumpp": "^12.2.1",
    "gh-changelogen": "^2.0.2",
    "knip": "^6.32.2",
    "oxc-minify": "^0.147.0",
    "pkg-pr-new": "^0.0.88",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.17"
  },
  "peerDependencies": {
    "vite": ">=5",
    "vitepress": ">=2.0.0-alpha.17"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@11.24.0"
}
